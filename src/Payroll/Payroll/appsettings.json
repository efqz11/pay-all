{
  "ConnectionStrings": {
    "HangfireConnection": "Server=.;Initial Catalog=Payroll.Master;User Id=sa;Password=User@123;TrustServerCertificate=True",
    "AccountConnection": "Server=.;Initial Catalog=Payroll.Account;User Id=sa;Password=User@123;TrustServerCertificate=True",
    "LogConnection": "Server=.;Initial Catalog=Payroll.Logs;User Id=sa;Password=User@123;TrustServerCertificate=True",
    "PayrollConnection": "Server=.;Initial Catalog=Payroll.Master;User Id=sa;Password=User@123;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AWS": {
    "Profile": "local-test-profile",
    "Region": "ap-southeast-1",
    "AWSAccessKey": "----",
    "AWSSecretKey": "----",
    "Timeout": 10000,
    "LogMetrics": true,
    "DisableLogging": false,
    "MaxErrorRetry": 8
  },
  "Serilog": {
    "Using": [],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "restrictedToMinimumLevel": "Error",
          "connectionString": "Server=.;Database=Payroll.Logs.Test;User Id=sa;Password=User@123;MultipleActiveResultSets=true;TrustServerCertificate=True",
          "tableName": "ApplicationLogs",
          "autoCreateSqlTable": false,
          "columnOptionsSection": {
            "customColumns": [
              {
                "ColumnName": "UserId",
                "DataType": "nvarchar",
                "AllowNull": true
              },
              {
                "ColumnName": "UserName",
                "DataType": "nvarchar",
                "AllowNull": true
              },
              {
                "ColumnName": "Environment",
                "DataType": "nvarchar",
                "AllowNull": true
              }
            ]
          }
        }
      }
    ],
    "Enrich": [
      "FromDiagnostiContext",
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": {
      "ApplicationName": "Payroll.App"
    }
  },
  "SupportEmail": "TechSupport@example.com",
  "AllowedHosts": "*",
  "Authentication:Google:ClientId": "",
  "Authentication:Google:ClientSecret": ""
}
